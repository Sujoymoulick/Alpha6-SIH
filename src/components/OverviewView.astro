<script is:inline>
  function filterOverviewTable(query) {
    const q = (query || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.overview-table-row');
    rows.forEach(r => {
      const text = r.getAttribute('data-text') || '';
      if (!q || text.includes(q)) {
        r.classList.remove('hidden');
      } else {
        r.classList.add('hidden');
      }
    });
  }

  function filterOverviewTableByDropdowns() {
    const unit = document.getElementById('overview-filter-unit')?.value || 'ALL';
    const cat = document.getElementById('overview-filter-cat')?.value || 'ALL';
    const rows = document.querySelectorAll('.overview-table-row');

    rows.forEach(r => {
      const rUnit = r.getAttribute('data-unit');
      const rCat = r.getAttribute('data-cat');
      const matchUnit = unit === 'ALL' || rUnit === unit;
      const matchCat = cat === 'ALL' || rCat === cat;

      if (matchUnit && matchCat) {
        r.classList.remove('hidden');
      } else {
        r.classList.add('hidden');
      }
    });
  }

  function updateOverviewLiveClock() {
    const clock = document.getElementById('live-overview-clock');
    if (!clock) return;
    const now = new Date();
    clock.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  setInterval(updateOverviewLiveClock, 1000);
  updateOverviewLiveClock();
</script>
