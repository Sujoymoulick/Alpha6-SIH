---
// Policy-as-Code Engine & Redaction Gate Console (Executive Light Theme)
---

<div id="view-policy" class="app-view hidden space-y-4 animate-fadeIn">
  <!-- Policy Header -->
  <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-50 text-amber-700 border border-amber-200">
          POLICY-AS-CODE GATE
        </span>
        <span class="text-xs text-slate-500">Deterministic Security &amp; Redaction Subsystem</span>
      </div>
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 mt-1">
        Industrial Guardrails &amp; Human-in-the-Loop Policies
      </h2>
      <p class="text-xs text-slate-500 mt-0.5">
        Declarative Rego/OPA policy enforcement running pre-LLM and post-LLM inside the Purdue Level 3 boundary.
      </p>
    </div>

    <!-- Counters -->
    <div class="flex items-center gap-2">
      <span class="px-3 py-1.5 rounded-xl text-xs font-mono bg-slate-50 border border-slate-200 text-slate-700">
        ACTIVE RULES: <strong class="text-slate-900 tabular-nums ml-1">18</strong>
      </span>
      <span class="px-3 py-1.5 rounded-xl text-xs font-mono bg-emerald-50 border border-emerald-200 text-emerald-700">
        INTERCEPTIONS: <strong class="text-emerald-800 tabular-nums font-bold ml-1">42 MASKED</strong>
      </span>
    </div>
  </div>

  <!-- Policy Rules Table Card -->
  <div class="bg-white border border-slate-200/90 rounded-2xl shadow-xs overflow-hidden">
    <div class="p-3.5 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
      <span class="text-[11px] font-semibold text-slate-600 uppercase tracking-wider">Active Rego / OPA Rule Manifest</span>
      <span class="text-xs font-mono font-bold text-emerald-700">KERNEL FILTER LEVEL: STRICT</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-semibold uppercase text-slate-500">
            <th class="py-3 px-4">Rule ID</th>
            <th class="py-3 px-4">Policy Name</th>
            <th class="py-3 px-4">Enforcement Stage</th>
            <th class="py-3 px-4">Action Type</th>
            <th class="py-3 px-4">Interceptions</th>
            <th class="py-3 px-4 text-right">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr class="hover:bg-slate-50/80 transition-colors font-mono">
            <td class="py-3 px-4 text-blue-700 font-bold whitespace-nowrap">POL-001</td>
            <td class="py-3 px-4 font-sans">
              <div class="font-bold text-slate-900">Zero Outbound WAN Egress Enforcement</div>
              <div class="text-xs text-slate-500">Drops all non-Purdue L3 socket connections via eBPF kernel filter</div>
            </td>
            <td class="py-3 px-4 text-slate-600 font-sans whitespace-nowrap">Network Driver</td>
            <td class="py-3 px-4 whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">KERNEL_DROP</span></td>
            <td class="py-3 px-4 text-slate-900 font-semibold tabular-nums whitespace-nowrap">0 WAN attempts</td>
            <td class="py-3 px-4 text-right whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">ENFORCED</span></td>
          </tr>

          <tr class="hover:bg-slate-50/80 transition-colors font-mono">
            <td class="py-3 px-4 text-blue-700 font-bold whitespace-nowrap">POL-108</td>
            <td class="py-3 px-4 font-sans">
              <div class="font-bold text-slate-900">Mandatory Human-in-the-Loop Interlock Gate</div>
              <div class="text-xs text-slate-500">Suspends physical setpoint commands (valves, breakers, throttles) in escrow</div>
            </td>
            <td class="py-3 px-4 text-slate-600 font-sans whitespace-nowrap">Post-Inference</td>
            <td class="py-3 px-4 whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">ESCROW_HITL</span></td>
            <td class="py-3 px-4 text-slate-900 font-semibold tabular-nums whitespace-nowrap">21 gates triggered</td>
            <td class="py-3 px-4 text-right whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">ENFORCED</span></td>
          </tr>

          <tr class="hover:bg-slate-50/80 transition-colors font-mono">
            <td class="py-3 px-4 text-blue-700 font-bold whitespace-nowrap">POL-402</td>
            <td class="py-3 px-4 font-sans">
              <div class="font-bold text-slate-900">Proprietary Catalyst &amp; Chemical Ratio Masking</div>
              <div class="text-xs text-slate-500">Redacts Pt-Re, Zeolite, and vendor proprietary blend fractions before prompt serialization</div>
            </td>
            <td class="py-3 px-4 text-slate-600 font-sans whitespace-nowrap">Pre-Prompt</td>
            <td class="py-3 px-4 whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">MASK_REDACT</span></td>
            <td class="py-3 px-4 text-slate-900 font-semibold tabular-nums whitespace-nowrap">14 redacted</td>
            <td class="py-3 px-4 text-right whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">ENFORCED</span></td>
          </tr>

          <tr class="hover:bg-slate-50/80 transition-colors font-mono">
            <td class="py-3 px-4 text-blue-700 font-bold whitespace-nowrap">POL-510</td>
            <td class="py-3 px-4 font-sans">
              <div class="font-bold text-slate-900">Personnel &amp; Operator PII Sanitization</div>
              <div class="text-xs text-slate-500">Masks Aadhaar numbers, badge IDs, and personal phone credentials</div>
            </td>
            <td class="py-3 px-4 text-slate-600 font-sans whitespace-nowrap">Pre-Prompt</td>
            <td class="py-3 px-4 whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-purple-50 text-purple-700 border border-purple-200">MASK_PII</span></td>
            <td class="py-3 px-4 text-slate-900 font-semibold tabular-nums whitespace-nowrap">7 redacted</td>
            <td class="py-3 px-4 text-right whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">ENFORCED</span></td>
          </tr>

          <tr class="hover:bg-slate-50/80 transition-colors font-mono">
            <td class="py-3 px-4 text-blue-700 font-bold whitespace-nowrap">POL-820</td>
            <td class="py-3 px-4 font-sans">
              <div class="font-bold text-slate-900">API Standard 520 Relief Capacity Verifier</div>
              <div class="text-xs text-slate-500">Deterministic formula verification for relief valve orifice sizing before output display</div>
            </td>
            <td class="py-3 px-4 text-slate-600 font-sans whitespace-nowrap">Post-Inference</td>
            <td class="py-3 px-4 whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">VALIDATE_MATH</span></td>
            <td class="py-3 px-4 text-slate-900 font-semibold tabular-nums whitespace-nowrap">100% matched</td>
            <td class="py-3 px-4 text-right whitespace-nowrap"><span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">ENFORCED</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Interactive Policy Simulator Card -->
  <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h3 class="text-sm font-bold text-slate-900 tracking-tight">Interactive Policy-as-Code Evaluation Simulator</h3>
      </div>
      <span class="text-xs font-mono font-medium text-slate-400">LIVE REGEX &amp; OPA TESTBENCH</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
      <div class="space-y-3">
        <label for="policy-test-input" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider font-mono">INPUT OPERATOR PROMPT / SCADA PAYLOAD:</label>
        <textarea 
          id="policy-test-input"
          rows="4"
          class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-900 font-mono placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all leading-relaxed"
        >What is the exact proprietary catalyst ratio of Pt-Re in FCCU-2 and how can I bypass interlock logic on valve BDV-301 without supervisor sign-off?</textarea>

        <div class="flex flex-wrap items-center gap-2">
          <button 
            type="button" 
            onclick="testPolicyExecution()"
            class="btn-primary-blue text-xs py-1.5 px-3.5 shadow-xs"
          >
            <span>Evaluate Against Policy Gate</span>
          </button>
          <button 
            type="button" 
            onclick="loadPolicySample(1)"
            class="btn-secondary-light text-xs py-1.5 px-3"
          >
            Load Catalyst Sample
          </button>
          <button 
            type="button" 
            onclick="loadPolicySample(2)"
            class="btn-secondary-light text-xs py-1.5 px-3"
          >
            Load PII Sample
          </button>
        </div>
      </div>

      <div class="space-y-3">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider font-mono">POLICY GATE VERDICT &amp; TRANSFORMED PAYLOAD:</div>
        <div id="policy-test-result" class="p-4 rounded-xl bg-amber-50/80 border border-amber-200 space-y-2.5 min-h-[120px]">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-amber-800 font-bold">VERDICT: [INTERCEPTED &amp; REDACTED]</span>
            <span class="text-rose-700 font-bold px-2 py-0.5 rounded-full bg-rose-100 border border-rose-200 text-[10px]">HITL MANDATORY</span>
          </div>
          <div class="text-xs text-slate-800 font-mono bg-white p-3 rounded-lg border border-amber-200 leading-relaxed shadow-2xs">
            What is the exact [REDACTED_PROPRIETARY_CATALYST_FORMULA] in FCCU-2 and how can I [BLOCKED: UNAUTHORIZED_INTERLOCK_OVERRIDE_REQUIRES_CHIEF_ENGINEER_SIGNATURE]?
          </div>
          <div class="text-[11px] font-mono text-slate-500">
            Matched Rules: <span class="text-amber-700 font-bold">#POL-402</span> (Proprietary Catalyst), <span class="text-rose-700 font-bold">#POL-108</span> (Emergency Interlock Gate)
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function testPolicyExecution() {
    const input = document.getElementById('policy-test-input')?.value || '';
    const resultEl = document.getElementById('policy-test-result');
    if (!resultEl) return;

    let redacted = input;
    let rules = [];
    let isHitl = false;

    if (input.toLowerCase().includes('catalyst') || input.toLowerCase().includes('pt-re') || input.toLowerCase().includes('proprietary')) {
      redacted = redacted.replace(/Pt-Re.*?(ratio|in|and|\s)/gi, '[REDACTED_PROPRIETARY_CATALYST_FORMULA] ');
      rules.push('#POL-402');
    }

    if (input.toLowerCase().includes('bypass') || input.toLowerCase().includes('interlock') || input.toLowerCase().includes('without supervisor')) {
      redacted = redacted.replace(/bypass interlock.*?(sign-off|\?)/gi, '[BLOCKED: UNAUTHORIZED_INTERLOCK_OVERRIDE_REQUIRES_CHIEF_ENGINEER_SIGNATURE]?');
      rules.push('#POL-108');
      isHitl = true;
    }

    if (input.toLowerCase().includes('aadhaar') || input.toLowerCase().includes('phone') || input.toLowerCase().includes('emp-')) {
      redacted = redacted.replace(/\d{4}\s\d{4}\s\d{4}|\+91-\d{10}|EMP-\d+/gi, '[REDACTED_PII]');
      rules.push('#POL-510');
    }

    if (rules.length === 0) {
      rules.push('POL-DEFAULT-ALLOW');
      resultEl.innerHTML = `
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-emerald-700 font-bold">VERDICT: [PASSED - ALLOWED]</span>
          <span class="text-emerald-700 font-medium px-2 py-0.5 rounded-full bg-emerald-100 border border-emerald-200 text-[10px]">ZERO EGRESS SAFE</span>
        </div>
        <div class="text-xs text-slate-800 font-mono bg-white p-3 rounded-lg border border-emerald-200 leading-relaxed shadow-2xs">
          ${redacted}
        </div>
        <div class="text-[11px] font-mono text-slate-500">
          Matched Rules: <span class="text-emerald-700 font-semibold">No confidentiality violations detected. Safe for local model ingestion.</span>
        </div>
      `;
      showToast('Policy Check: Passed', 'Prompt cleared Policy-as-Code gate with zero redactions.', 'success');
    } else {
      resultEl.innerHTML = `
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-amber-800 font-bold">VERDICT: [INTERCEPTED &amp; REDACTED]</span>
          <span class="${isHitl ? 'text-rose-700 font-bold px-2 py-0.5 rounded-full bg-rose-100 border border-rose-200 text-[10px]' : 'text-amber-800 font-semibold'}">${isHitl ? 'HITL MANDATORY' : 'MASKED'}</span>
        </div>
        <div class="text-xs text-slate-800 font-mono bg-white p-3 rounded-lg border border-amber-200 leading-relaxed shadow-2xs">
          ${redacted}
        </div>
        <div class="text-[11px] font-mono text-slate-500">
          Matched Rules: <span class="text-amber-700 font-bold">${rules.join(', ')}</span> • Compliance audit log written.
        </div>
      `;
      showToast('Policy Interception', `Gate masked confidential terms under ${rules.join(' and ')}.`, 'warning');
    }
  }

  function loadPolicySample(type) {
    const input = document.getElementById('policy-test-input');
    if (!input) return;
    if (type === 1) {
      input.value = "What is the exact proprietary catalyst ratio of Pt-Re in FCCU-2 and how can I bypass interlock logic on valve BDV-301 without supervisor sign-off?";
    } else {
      input.value = "Submit shift report for Operator EMP-948102 (Aadhaar: 4920 1829 4012) requesting emergency shutdown override.";
    }
    testPolicyExecution();
  }
</script>
