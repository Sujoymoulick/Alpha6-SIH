---
import { INITIAL_RECORDS } from '../data/sampleRecords';
---

<div id="view-records" class="app-view hidden space-y-4 animate-fadeIn">
  <!-- Records Vault Header -->
  <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-50 text-amber-700 border border-amber-200">
          OPERATIONAL RECORDS &amp; INCIDENT LOGS
        </span>
        <span class="text-xs text-slate-500">On-Premise Encrypted Storage</span>
      </div>
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 mt-1">
        Confidential Industrial Incident &amp; Supervisory Records
      </h2>
      <p class="text-xs text-slate-500 mt-0.5">
        Verified operations, pending human supervisory actions, deterministic rejections, and equipment audits.
      </p>
    </div>

    <!-- Active Count Badges -->
    <div class="flex items-center gap-2">
      <span class="px-3 py-1.5 rounded-xl text-xs font-mono bg-slate-50 border border-slate-200 text-slate-700">
        TOTAL: <strong class="text-slate-900 tabular-nums ml-1" id="records-total-count">{INITIAL_RECORDS.length}</strong>
      </span>
      <span class="px-3 py-1.5 rounded-xl text-xs font-mono bg-rose-50 border border-rose-200 text-rose-700">
        PENDING HITL: <strong class="text-rose-800 tabular-nums font-bold ml-1" id="records-hitl-count">2</strong>
      </span>
    </div>
  </div>

  <!-- Filters & Search Bar -->
  <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-xs space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <!-- Search Input -->
      <div>
        <label for="records-search-input" class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Search Records &amp; Tags</label>
        <div class="relative">
          <input 
            type="text" 
            id="records-search-input"
            oninput="filterRecordsClientSide()"
            placeholder="Search ST-401, PSV-2041, P-102B..." 
            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
          />
          <div class="absolute right-3 top-2.5 text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Plant Unit Filter -->
      <div>
        <label for="records-unit-select" class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Plant Unit</label>
        <select 
          id="records-unit-select" 
          onchange="filterRecordsClientSide()"
          class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-xs rounded-xl px-3 py-2 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
        >
          <option value="ALL">All Units</option>
          <option value="CDU-1">CDU-1 (Crude Distillation)</option>
          <option value="HCU-3">HCU-3 (Hydrocracker)</option>
          <option value="FCCU-2">FCCU-2 (Catalytic Cracker)</option>
          <option value="SRU-2">SRU-2 (Sulfur Recovery)</option>
          <option value="Utilities">Utilities &amp; Turbines</option>
          <option value="Tank Farm">Tank Farm</option>
        </select>
      </div>

      <!-- Category Filter -->
      <div>
        <label for="records-cat-select" class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Category</label>
        <select 
          id="records-cat-select" 
          onchange="filterRecordsClientSide()"
          class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-xs rounded-xl px-3 py-2 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
        >
          <option value="ALL">All Categories</option>
          <option value="SOP">SOP Verification</option>
          <option value="P&ID">P&amp;ID Blueprint</option>
          <option value="Telemetry / Alarm">Telemetry / Alarm</option>
          <option value="Incident">Incident Review</option>
          <option value="HSE Safety">HSE Safety</option>
          <option value="Maintenance">Maintenance</option>
        </select>
      </div>

      <!-- Status Filter -->
      <div>
        <label for="records-status-select" class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Status</label>
        <select 
          id="records-status-select" 
          onchange="filterRecordsClientSide()"
          class="w-full bg-slate-50 border border-slate-200 text-slate-800 text-xs rounded-xl px-3 py-2 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
        >
          <option value="ALL">All Statuses</option>
          <option value="Verified">Verified</option>
          <option value="Completed">Completed</option>
          <option value="Pending Approval">Pending Approval (HITL)</option>
          <option value="Invalid Input">Invalid Input</option>
          <option value="No Result">No Result</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Records Grid Container -->
  <div id="records-cards-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {INITIAL_RECORDS.map((rec) => {
      const isPending = rec.status === 'Pending Approval';
      const isInvalid = rec.status === 'Invalid Input';
      const isNoResult = rec.status === 'No Result';

      const statusBadgeClass = isPending 
        ? "bg-amber-50 text-amber-700 border-amber-200 font-semibold"
        : isInvalid
        ? "bg-rose-50 text-rose-700 border-rose-200 font-semibold"
        : isNoResult
        ? "bg-slate-100 text-slate-600 border-slate-200"
        : "bg-emerald-50 text-emerald-700 border-emerald-200 font-semibold";

      return (
        <div 
          class="record-item-card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:border-blue-300 hover:shadow-sm transition-all flex flex-col justify-between space-y-3.5"
          data-id={rec.id}
          data-unit={rec.plantUnit}
          data-category={rec.category}
          data-status={rec.status}
          data-title={rec.title}
          data-tag={rec.details.equipmentTag || ''}
          data-number={rec.recordNumber}
        >
          <div class="space-y-2.5">
            <!-- Top bar -->
            <div class="flex items-center justify-between gap-2 text-xs">
              <span class="font-mono text-blue-600 font-bold">{rec.recordNumber}</span>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-mono bg-slate-100 text-slate-600 border border-slate-200">
                  {rec.plantUnit}
                </span>
                <span class={`px-2.5 py-0.5 rounded-full text-[10px] border ${statusBadgeClass}`}>
                  {rec.status}
                </span>
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-sm font-bold text-slate-900 leading-snug">
              {rec.title}
            </h3>

            <!-- Summary -->
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
              {rec.summary}
            </p>

            <!-- Metadata info -->
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 pt-0.5 font-mono">
              {rec.details.equipmentTag && (
                <div>TAG: <span class="text-slate-900 font-semibold">{rec.details.equipmentTag}</span></div>
              )}
              <div>CONFIDENCE: <strong class="text-emerald-600 tabular-nums">{Math.round(rec.confidenceScore * 100)}%</strong></div>
            </div>

            <!-- Simulated Data Notice -->
            <div class="text-[10px] font-mono text-slate-400 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-200">
              BENCHMARK DATASET • {rec.scenarioType.toUpperCase()} SCENARIO
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
            <button 
              type="button" 
              onclick={`inspectRecordById(${JSON.stringify(rec.id)})`}
              class="btn-secondary-light text-xs py-1.5 px-3"
            >
              Inspect Details
            </button>

            {isPending && (
              <button 
                type="button" 
                onclick={`openHitlApprovalModal(${JSON.stringify(rec.id)})`}
                class="btn-primary-blue text-xs py-1.5 px-3"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Authorize HITL</span>
              </button>
            )}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Empty state container -->
  <div id="records-empty-state" class="hidden p-12 text-center bg-white border border-slate-200/90 rounded-2xl shadow-xs space-y-3">
    <div class="w-12 h-12 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center mx-auto text-slate-400">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h4 class="text-sm font-bold text-slate-900">No matching plant records found</h4>
    <p class="text-xs text-slate-500 max-w-sm mx-auto">
      Adjust your search query or reset filter dropdowns to view all indexed confidential records.
    </p>
    <button 
      type="button" 
      onclick="resetRecordFilters()"
      class="btn-secondary-light text-xs py-1.5 px-3"
    >
      Reset Filters
    </button>
  </div>
</div>

<script type="application/json" id="records-initial-data" set:html={JSON.stringify(INITIAL_RECORDS)} />

<script is:inline>
  let cachedRecords = [];
  try {
    const rawEl = document.getElementById('records-initial-data');
    if (rawEl) cachedRecords = JSON.parse(rawEl.textContent || '[]');
  } catch (e) {
    cachedRecords = [];
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function renderRecordsCards(records) {
    const container = document.getElementById('records-cards-container');
    if (!container) return;

    container.innerHTML = '';
    records.forEach(rec => {
      const isPending = rec.status === 'Pending Approval';
      const isInvalid = rec.status === 'Invalid Input';
      const isNoResult = rec.status === 'No Result';

      const statusBadgeClass = isPending 
        ? "bg-amber-50 text-amber-700 border-amber-200 font-semibold"
        : isInvalid
        ? "bg-rose-50 text-rose-700 border-rose-200 font-semibold"
        : isNoResult
        ? "bg-slate-100 text-slate-600 border-slate-200"
        : "bg-emerald-50 text-emerald-700 border-emerald-200 font-semibold";

      const card = document.createElement('div');
      card.className = 'record-item-card bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:border-blue-300 hover:shadow-sm transition-all flex flex-col justify-between space-y-3.5';
      card.setAttribute('data-id', rec.id);
      card.setAttribute('data-unit', rec.plantUnit);
      card.setAttribute('data-category', rec.category);
      card.setAttribute('data-status', rec.status);
      card.setAttribute('data-title', rec.title);
      card.setAttribute('data-tag', rec.details.equipmentTag || '');
      card.setAttribute('data-number', rec.recordNumber);

      card.innerHTML = `
        <div class="space-y-2.5">
          <div class="flex items-center justify-between gap-2 text-xs">
            <span class="font-mono text-blue-600 font-bold">${escapeHtml(rec.recordNumber)}</span>
            <div class="flex items-center gap-1.5">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-mono bg-slate-100 text-slate-600 border border-slate-200">
                ${escapeHtml(rec.plantUnit)}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] border ${statusBadgeClass}">
                ${escapeHtml(rec.status)}
              </span>
            </div>
          </div>
          <h3 class="text-sm font-bold text-slate-900 leading-snug">
            ${escapeHtml(rec.title)}
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
            ${escapeHtml(rec.summary)}
          </p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 pt-0.5 font-mono">
            ${rec.details.equipmentTag ? `<div>TAG: <span class="text-slate-900 font-semibold">${escapeHtml(rec.details.equipmentTag)}</span></div>` : ''}
            <div>CONFIDENCE: <strong class="text-emerald-600 tabular-nums">${Math.round(rec.confidenceScore * 100)}%</strong></div>
          </div>
          <div class="text-[10px] font-mono text-slate-400 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-200">
            BENCHMARK DATASET • ${(rec.scenarioType || 'standard').toUpperCase()} SCENARIO
          </div>
        </div>
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
          <button 
            type="button" 
            onclick="inspectRecordById('${escapeHtml(rec.id)}')"
            class="btn-secondary-light text-xs py-1.5 px-3"
          >
            Inspect Details
          </button>
          ${isPending ? `
            <button 
              type="button" 
              onclick="openHitlApprovalModal('${escapeHtml(rec.id)}')"
              class="btn-primary-blue text-xs py-1.5 px-3"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Authorize HITL</span>
            </button>
          ` : ''}
        </div>
      `;
      container.appendChild(card);
    });

    const hitlCount = records.filter(r => r.status === 'Pending Approval').length;
    const hitlBadge = document.getElementById('records-hitl-count');
    if (hitlBadge) hitlBadge.textContent = hitlCount;
  }

  function filterRecordsClientSide() {
    const search = (document.getElementById('records-search-input')?.value || '').toLowerCase().trim();
    const unit = document.getElementById('records-unit-select')?.value || 'ALL';
    const category = document.getElementById('records-cat-select')?.value || 'ALL';
    const status = document.getElementById('records-status-select')?.value || 'ALL';

    const filtered = cachedRecords.filter(rec => {
      const matchSearch = !search || 
        rec.title.toLowerCase().includes(search) || 
        rec.recordNumber.toLowerCase().includes(search) || 
        (rec.details.equipmentTag && rec.details.equipmentTag.toLowerCase().includes(search)) ||
        rec.summary.toLowerCase().includes(search);

      const matchUnit = unit === 'ALL' || rec.plantUnit === unit;
      const matchCategory = category === 'ALL' || rec.category === category;
      const matchStatus = status === 'ALL' || rec.status === status;

      return matchSearch && matchUnit && matchCategory && matchStatus;
    });

    renderRecordsCards(filtered);

    const empty = document.getElementById('records-empty-state');
    if (empty) {
      if (filtered.length === 0) empty.classList.remove('hidden');
      else empty.classList.add('hidden');
    }

    const totalBadge = document.getElementById('records-total-count');
    if (totalBadge) totalBadge.textContent = filtered.length;
  }

  function resetRecordFilters() {
    const searchInput = document.getElementById('records-search-input');
    const unitSelect = document.getElementById('records-unit-select');
    const catSelect = document.getElementById('records-cat-select');
    const statusSelect = document.getElementById('records-status-select');
    if (searchInput) searchInput.value = '';
    if (unitSelect) unitSelect.value = 'ALL';
    if (catSelect) catSelect.value = 'ALL';
    if (statusSelect) statusSelect.value = 'ALL';
    filterRecordsClientSide();
  }

  function inspectRecordById(id) {
    const rec = cachedRecords.find(r => r.id === id);
    if (!rec) return;

    if (typeof showDocumentDrawer === 'function') {
      showDocumentDrawer({
        docNumber: rec.recordNumber,
        title: rec.title,
        type: rec.category,
        plantUnit: rec.plantUnit,
        classification: 'RESTRICTED',
        description: rec.summary,
        keyTags: [rec.details.equipmentTag || 'EQUIPMENT', rec.plantUnit, rec.status],
        contentSnippet: JSON.stringify(rec.details, null, 2),
        vectorChunksCount: 6,
        pagesCount: 1,
        sourceLocation: `encrypted_records_db://${rec.recordNumber}.bin`
      });
    }
  }

  window.reloadRecordsFromApi = async function() {
    try {
      const res = await fetch('/api/records');
      if (res.ok) {
        cachedRecords = await res.json();
        filterRecordsClientSide();
      }
    } catch (e) {
      console.error('Failed to reload records:', e);
    }
  };
</script>
